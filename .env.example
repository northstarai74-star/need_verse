# Copy this file to ".env" and paste your keys from
# Razorpay Dashboard -> Account & Settings -> API Keys.
# Start with TEST keys (they begin with rzp_test_). Never commit .env.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
PORT=3000

# Webhook secret: Razorpay Dashboard -> Account & Settings -> Webhooks -> Add New Webhook.
# URL: https://YOUR-DOMAIN/api/razorpay-webhook   Events: payment.captured, order.paid, refund.created, refund.processed, refund.failed
# Type any secret you like there and paste the same value here.
RAZORPAY_WEBHOOK_SECRET=

# Order emails (any SMTP service: Gmail app password, Brevo, Zoho, SendGrid...)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Nnedverse <you@gmail.com>"
# Gets a copy of every paid order:
OWNER_EMAIL=you@gmail.com

# Orders page at /admin (browser login prompt). Choose a long password.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Session secret for signed cookies (used for sign in/sign out)
# Generate a long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production

# Database: Supabase -> Project Settings -> API.
# Use the Project URL and the "service_role" key (NOT the anon key).
# The service_role key has full access: keep it on the server only, never in public/ or the browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
