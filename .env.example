# Copy this file to ".env" and fill it in. Never commit .env.
# Only the first two sections are required to start; the rest switch features on.

# ---------- Required: payments (Razorpay Dashboard -> Account & Settings -> API Keys) ----------
# Start with TEST keys (rzp_test_...). Switch to live keys only after a full test order and refund.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Razorpay Dashboard -> Webhooks -> Add New Webhook. URL: https://YOUR-DOMAIN/api/razorpay-webhook
# Events: payment.captured, order.paid, refund.created, refund.processed, refund.failed. Paste the same secret here.
RAZORPAY_WEBHOOK_SECRET=

# ---------- Required: database (Supabase -> Project Settings -> API) ----------
# Run schema.sql in the Supabase SQL Editor, then `npm run seed`.
# The service_role key has full access: keep it on the server only.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Site ----------
PORT=3000
NODE_ENV=production
# Your public address, used in emails, the sitemap and canonical links.
PUBLIC_URL=https://www.example.com
# Set to 1 when running behind one reverse proxy or load balancer (Render, Railway, Heroku, Nginx...).
# Without it every shopper shares the proxy's IP and rate limits hit everyone together.
TRUST_PROXY=1

# ---------- Admin (/admin) ----------
ADMIN_USER=admin
ADMIN_PASSWORD=
# Two-factor sign in. Run `npm run totp`, paste the secret here and add it to your authenticator app.
ADMIN_TOTP_SECRET=

# ---------- Business details (invoices, footer, policy pages) ----------
BUSINESS_NAME=Nnedverse
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
# Must match a state name exactly, e.g. Karnataka. Decides CGST+SGST vs IGST on invoices.
BUSINESS_STATE=
BUSINESS_GSTIN=
BUSINESS_EMAIL=
BUSINESS_PHONE=
# Required by the Consumer Protection (E-Commerce) Rules, 2020.
GRIEVANCE_OFFICER=
GRIEVANCE_EMAIL=
GRIEVANCE_PHONE=
JURISDICTION_CITY=
# Set to true after a lawyer has reviewed the policy pages to remove the "draft" notice.
POLICIES_REVIEWED=false

# ---------- Email (any SMTP: Gmail app password, Brevo, Zoho, SendGrid...) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Nnedverse <you@gmail.com>"
# Gets a copy of every order, return requests and low-stock alerts.
OWNER_EMAIL=you@gmail.com
# Set to false to stop the one-time "you left something in your cart" email.
ABANDONED_CART_EMAILS=true
# Days after delivery to ask for a review.
REVIEW_REQUEST_DAYS=3

# ---------- Checkout ----------
COD_ENABLED=true
# Minutes an unpaid online checkout holds its stock before it expires.
ORDER_HOLD_MINUTES=30
# Delivery estimate when Shiprocket isn't set up, as "min-max" days.
DEFAULT_ETA_DAYS=3-7
# PIN codes you don't deliver to, comma separated.
BLOCKED_PINS=

# ---------- Courier: Shiprocket (optional) ----------
# Live delivery estimates and COD checks per PIN code, plus one-click courier booking in the admin.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIP_FROM_PIN=
SHIPROCKET_PICKUP=Primary
# Shiprocket -> Settings -> API -> Webhooks: URL https://YOUR-DOMAIN/api/shiprocket-webhook with this token.
SHIPROCKET_WEBHOOK_TOKEN=

# ---------- WhatsApp order updates: Meta WhatsApp Cloud API (optional) ----------
# Create and get approval for these message templates in WhatsApp Manager first.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WA_TPL_ORDER=         # body: {{1}} name, {{2}} order number, {{3}} amount
WA_TPL_SHIPPED=       # body: {{1}} name, {{2}} order number, {{3}} tracking link or number
WA_TPL_DELIVERED=     # body: {{1}} name, {{2}} order number
WA_TPL_LANG=en

# ---------- AI fit assistant (optional) ----------
# Claude API key from console.anthropic.com. Leave empty to hide the assistant.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# ---------- Error alerts (optional) ----------
# A Slack or Discord incoming-webhook URL. Server errors are posted here (at most once per 10 minutes each).
ERROR_WEBHOOK_URL=
